# ============================================================================
# Environment Configuration for Local Development
# ============================================================================
# Copy this file to .env and fill in your values.
#
# IMPORTANT: Variables prefixed with MY_ are for LOCAL development only.
# In Foundry Hosted Agent, the platform injects FOUNDRY_* and AGENT_* vars
# automatically (without the MY_ prefix). The code handles both cases.
# ============================================================================

# Microsoft Foundry Project endpoint
# Format: https://<account>.services.ai.azure.com/api/projects/<project>
MY_FOUNDRY_PROJECT_ENDPOINT=

# Model deployment name (e.g., gpt-4o, gpt-4o-mini)
MY_AZURE_AI_MODEL_DEPLOYMENT_NAME=

# ============================================================================
# Optional: Tracing / Observability (uncomment to enable)
# ============================================================================
# MY_FOUNDRY_TRACING_ENDPOINT=https://your-account.services.ai.azure.com/api/projects/your-project
# APPLICATIONINSIGHTS_CONNECTION_STRING=InstrumentationKey=...
